.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

.env
.env.*
!.env.example

api/*.db
api/*.sqlite
api/*.sqlite3
*.db
!mlflow.db.example

frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Generated pipeline data. Keep folder placeholders only.
data/raw/*
data/validated/*
data/curated/*
data/rejected/*
!data/**/.gitkeep

mlruns/
artifacts/
logs/

# Model binaries are reproducible from scripts and can be too large for normal git history.
*.joblib
*.pkl
*.onnx

# Power BI temporary files.
*.pbix~

# npm is the supported frontend package manager for version 1.
frontend/pnpm-lock.yaml

# Power BI project hygiene.
reports/powerbi/**/*.pbix
reports/powerbi/**/.pbi/
reports/powerbi/backup_before_dashboard_pages_*/
# Airflow local runtime state.
airflow/logs/*
!airflow/logs/.gitkeep
airflow/*.db
airflow/airflow.cfg
airflow/webserver_config.py
reports/orchestration/
