table 'fraudops_reporting vw_alert_operations'
	lineageTag: cf989260-7d56-4b1b-a070-209c50e89e35

	measure 'Alert Count' = COUNTROWS('fraudops_reporting vw_alert_operations')
		formatString: #,0
		lineageTag: e8d68b7d-b7b9-4053-a115-a0ebbfa51cd3

	measure 'SLA Breaches' = CALCULATE(COUNTROWS('fraudops_reporting vw_alert_operations'), 'fraudops_reporting vw_alert_operations'[sla_breached] = TRUE())
		formatString: #,0
		lineageTag: 94f5997d-0d08-49e6-a8c5-d65735e14f18

	measure 'Open Alert Backlog' = CALCULATE(COUNTROWS('fraudops_reporting vw_alert_operations'), 'fraudops_reporting vw_alert_operations'[alert_status] <> "CLOSED")
		formatString: #,0
		lineageTag: b9926351-9cfc-4a42-b4b9-1cb70e4c088b

	measure 'Average Alert Age Hours' = DIVIDE(AVERAGE('fraudops_reporting vw_alert_operations'[alert_age_minutes]), 60)
		formatString: 0.0
		lineageTag: 7bdb02b0-fbc8-480c-a5e2-bc45ee495cff

