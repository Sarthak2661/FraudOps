table 'fraudops_reporting vw_daily_fraud_summary'
	lineageTag: 6cef773f-5cdf-415c-aa8a-93cb14ebc955

	measure 'Fraud Value Capture Rate' = DIVIDE(SUM('fraudops_reporting vw_daily_fraud_summary'[prevented_fraud_value]), SUM('fraudops_reporting vw_daily_fraud_summary'[attempted_fraud_value]))
